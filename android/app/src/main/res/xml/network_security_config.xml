<?xml version="1.0" encoding="utf-8"?>
<!-- Mengizinkan HTTP ke server lokal Termux (127.0.0.1). Tanpa ini Android memblokir
     dengan error "Cleartext HTTP traffic to 127.0.0.1 not permitted". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
