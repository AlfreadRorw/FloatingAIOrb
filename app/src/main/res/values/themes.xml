<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ALFVoiceControl" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/alf_background</item>
        <item name="android:navigationBarColor">@color/alf_background</item>
        <item name="android:windowBackground">@color/alf_background</item>
    </style>

    <style name="Theme.ALFVoiceControl.ScreenWake" parent="Theme.ALFVoiceControl">
        <!-- windowShowWhenLocked / windowTurnScreenOn are NOT valid theme/style
             attributes - they don't exist in the framework as <item> targets.
             The actual mechanism is either:
               (a) the <activity android:showWhenLocked="true" android:turnScreenOn="true">
                   manifest attributes (API 27+), or
               (b) the runtime calls Activity#setShowWhenLocked() / setTurnScreenOn()
             both of which are already set up in AndroidManifest.xml and
             ScreenWakeActivity.kt. This style only needs to exist for its
             background/color inheritance from the parent theme. -->
    </style>
</resources>
