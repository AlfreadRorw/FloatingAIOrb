<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Only the lock-screen policy is requested, needed for the
             "Screen Off" voice command (DevicePolicyManager#lockNow()).
             ALF never reads, stores or bypasses the user's screen lock. -->
        <limit-password />
        <force-lock />
    </uses-policies>
</device-admin>
